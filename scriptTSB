local function MakeColor(name, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(40, 40)
	b.BackgroundColor3 = color
	b.Text = ""
	b.AutoButtonColor = false
	b.Parent = ColorRow
	Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = (name == CurrentThemeName) and 0 or 1
	stroke.Parent = b

	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
			Size = UDim2.fromOffset(46, 46)
		}):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.2), {
			Size = UDim2.fromOffset(40, 40)
		}):Play()
	end)

	b.MouseButton1Click:Connect(function()
		CurrentThemeName = name
		CurrentTheme = color

		for _, c in ipairs(ColorRow:GetChildren()) do
			if c:IsA("TextButton") and c:FindFirstChild("UIStroke") then
				TweenService:Create(c.UIStroke, TweenInfo.new(0.25), {
					Transparency = (c == b) and 0 or 1
				}):Play()
			end
		end

		ApplyTheme(color)

		TweenService:Create(OpenButton, TweenInfo.new(0.35), {TextColor3 = color}):Play()
		TweenService:Create(OpenStroke, TweenInfo.new(0.35), {Color = color}):Play()
		TweenService:Create(OpenGlow, TweenInfo.new(0.35), {ImageColor3 = color}):Play()

		-- update active nav button
		if NavButtons[ActivePage] then
			TweenService:Create(NavButtons[ActivePage], TweenInfo.new(0.3), {
				BackgroundColor3 = color
			}):Play()
		end
	end)
end

