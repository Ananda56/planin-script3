-- SINGLE HEARTBEAT LOOP (Consolidated)
-- ═══════════════════════════════════════════════════════════════════
local fpsCounter   = 0
local fpsTimer     = 0
local gradRotation = 0

RunService.Heartbeat:Connect(function(dt)
	-- Gradient animation
	gradRotation = (gradRotation + dt * 15) % 360
	HeaderGrad.Rotation = gradRotation

	-- FPS / Ping update (every 0.5s)
	fpsCounter = fpsCounter + 1
	fpsTimer   = fpsTimer + dt
	if fpsTimer >= 0.5 then
		local fps = math.round(fpsCounter / fpsTimer)
		fpsCounter = 0
		fpsTimer   = 0
		local ping = math.round(Stats.Network.ServerStatsItem["Data Ping"]:GetValueMilliseconds())
		FpsDisplay.Text  = "FPS\n" .. fps
		PingDisplay.Text = "PING\n" .. ping .. "ms"

		FpsDisplay.TextColor3  = fps < 30 and Color3.fromHex("#F87171")
			or (fps < 55 and Color3.fromHex("#F0C14B") or Color3.fromHex("#34D399"))
		PingDisplay.TextColor3 = ping > 200 and Color3.fromHex("#F87171")
			or (ping > 100 and Color3.fromHex("#F0C14B") or Color3.fromHex("#34D399"))
	end

	-- Particles
	for i = #Particles, 1, -1 do
		local p = Particles[i]
		p.life = p.life + dt
		if p.life > p.max then
			local dot = p.dot
			table.remove(Particles, i)
			ReturnPooledParticle(dot)
			SpawnParticle()
		else
			local t = p.life / p.max
			local wobbleOff = math.sin(t * math.pi * 2 * p.wobbleSpeed) * p.wobble
			p.dot.Position = UDim2.new(
				p.dot.Position.X.Scale + p.dx + wobbleOff * 0.001,
				0,
				p.dot.Position.Y.Scale + p.dy,
				0
			)
			p.dot.BackgroundTransparency = 0.5 + t * 0.45
		end
	end
end)

