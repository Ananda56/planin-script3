-- OPEN / CLOSE PANEL LOGIC - Enhanced Animation
-- ═══════════════════════════════════════════════════════
local PANEL_W, PANEL_H = 780, 520

local function OpenPanel()
	if State.IsOpen then return end
	State.IsOpen = true
	MainFrame.Visible = true
	MainFrame.Size = UDim2.fromOffset(0, 0)
	MainFrame.BackgroundTransparency = 1

	-- Staggered open animation
	Tween(MainFrame, BackOut(0.55), {
		Size = UDim2.fromOffset(PANEL_W, PANEL_H),
		BackgroundTransparency = 0.06,
	})
	Tween(OrbGlow1, QuartOut(0.3), { ImageTransparency = 0.2 })
	Tween(OrbGlow2, QuartOut(0.3), { ImageTransparency = 0.4 })

	-- Staggered content reveal
	task.delay(0.25, function()
		SetActiveTab("Combat")
	end)

	task.delay(0.6, function()
		SwitchPage = SetActiveTab
	end)
end

local function ClosePanel()
	if not State.IsOpen then return end
	State.IsOpen = false

	local tw = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
	})
	tw:Play()
	tw.Completed:Connect(function()
		MainFrame.Visible = false
		State.IsMinimized = false
	end)
	Tween(OrbGlow1, QuartOut(0.3), { ImageTransparency = 0.55 })
	Tween(OrbGlow2, QuartOut(0.3), { ImageTransparency = 0.78 })
end

local function ToggleMinimize()
	State.IsMinimized = not State.IsMinimized
	local targetH = State.IsMinimized and 68 or PANEL_H
	Tween(MainFrame, QuartOut(0.4), { Size = UDim2.fromOffset(PANEL_W, targetH) })
end

OpenButton.MouseButton1Click:Connect(function()
	if State.IsOpen then ClosePanel() else OpenPanel() end
end)
CloseBtn.MouseButton1Click:Connect(ClosePanel)
MinBtn.MouseButton1Click:Connect(ToggleMinimize)

-- Keybind toggle panel
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == State.Keybinds["kb_open"] then
		if State.IsOpen then ClosePanel() else OpenPanel() end
	end
end)

