local function TeleportToTarget()
	if not State.SelectedTarget or not State.SelectedTarget.Character then
		Notify("Teleport Failed", "No target selected or target is unavailable.", 3, "⚡")
		return
	end
	local myChar     = LocalPlayer.Character
	local targetChar = State.SelectedTarget.Character
	if not myChar or not targetChar then return end

	local myRoot     = myChar:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	if myRoot and targetRoot then
		myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
		Notify("Teleported!", "Jumped to " .. State.SelectedTarget.Name, 2.5, "⚡")
	end
end

