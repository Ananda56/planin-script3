local Pages = {}
local NavButtons = {}
local ActivePage = "Home"

local function SwitchPage(name)
	ActivePage = name
	for n, page in pairs(Pages) do
		page.Visible = (n == name)
		if n == name then
			page.Position = UDim2.new(0, 0, 0.03, 0)
			TweenService:Create(page, TweenInfo.new(0.35, Enum.EasingStyle.Quart), {
				Position = UDim2.fromOffset(0, 0)
			}):Play()
		end
	end

	for n, btn in pairs(NavButtons) do
		if n == name then
			TweenService:Create(btn, TweenInfo.new(0.25), {
				BackgroundTransparency = 0,
				TextColor3 = Color3.fromRGB(15, 15, 20)
			}):Play()
			TweenService:Create(btn, TweenInfo.new(0.25), {
				BackgroundColor3 = CurrentTheme
			}):Play()
		else
			TweenService:Create(btn, TweenInfo.new(0.25), {
				BackgroundTransparency = 1,
				TextColor3 = Color3.fromRGB(170, 170, 180),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			}):Play()
		end
	end
end

local function CreateNav(name, label)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(140, 32)
	btn.BackgroundColor3 = CurrentTheme
	btn.BackgroundTransparency = 1
	btn.Text = label
	btn.TextColor3 = Color3.fromRGB(170, 170, 180)
