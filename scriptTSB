-- FPS/Ping update loop
local fpsFrames = 0
local fpsClock  = 0
RunService.Heartbeat:Connect(function(dt)
	fpsFrames = fpsFrames + 1
	fpsClock  = fpsClock + dt
	if fpsClock >= 0.5 then
		local fps = math.round(fpsFrames / fpsClock)
		fpsFrames = 0
		fpsClock  = 0
		local ping = math.round(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		FpsLabel.Text  = "FPS\n" .. fps
		PingLabel.Text = "PING\n" .. ping .. "ms"
		FpsLabel.TextColor3  = fps < 30 and Color3.fromHex("#F87171") or (fps < 55 and Color3.fromHex("#F0C14B") or Color3.fromHex("#34D399"))
		PingLabel.TextColor3 = ping > 200 and Color3.fromHex("#F87171") or (ping > 100 and Color3.fromHex("#F0C14B") or Color3.fromHex("#34D399"))
	end
end)

