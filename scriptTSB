	if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragOrigin
		MainFrame.Position = UDim2.new(
			panelOrigin.X.Scale,
			panelOrigin.X.Offset + delta.X,
			panelOrigin.Y.Scale,
			panelOrigin.Y.Offset + delta.Y
		)
	end
end)

