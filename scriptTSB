-- KEYBIND HANDLER (Fixed: empty if/else removed)
-- ═══════════════════════════════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

	if assigningKeyId then
		State.Keybinds[assigningKeyId] = input.KeyCode
		local btn = State.KeybindActions and State.KeybindActions[assigningKeyId]
		if btn then
			btn.Text = "[" .. input.KeyCode.Name .. "]"
			btn.TextColor3 = CurrentTheme
			Util.Tween(btn, Util.QuartOut(0.2), { Size = UDim2.fromOffset(100, 36), BackgroundTransparency = 0.2 })
		end
		Notify("Keybind Set", "New key: " .. input.KeyCode.Name, 2.5, "✅")
		assigningKeyId = nil
		return
	end

	local key = input.KeyCode
	if key == State.Keybinds["kb_open"] then
		if State.IsOpen then ClosePanel() else OpenPanel() end
	elseif key == State.Keybinds["kb_tp"] then
		TeleportToTarget()
	elseif key == State.Keybinds["kb_spawn"] then
		GoToSpawn()
	end
end)

