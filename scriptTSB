}

local CurrentThemeIndex = 1
local CurrentTheme      = THEMES[1].color
local CurrentThemeName  = THEMES[1].name

-- ThemeElements with hard cap to prevent memory leak
local ThemeElements     = setmetatable({}, { __mode = "kv" })
local THEME_CAP         = 200

local function RegisterTheme(obj, prop)
	if #ThemeElements >= THEME_CAP then
		table.remove(ThemeElements, 1)
	end
	table.insert(ThemeElements, { Object = obj, Prop = prop })
end

local function ApplyTheme(color, duration)
	duration = duration or 0.4
	CurrentTheme = color
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local count = #ThemeElements
	for i, item in ipairs(ThemeElements) do
		local obj, prop = item.Object, item.Prop
		if obj and obj.Parent then
			task.delay((i / count) * 0.06, function()
				pcall(function()
					TweenService:Create(obj, info, { [prop] = color }):Play()
				end)
			end)
		end
	end
end

