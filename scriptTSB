-- OPEN / CLOSE PANEL
-- ═══════════════════════════════════════════════════════════════════
local function OpenPanel()
	if State.IsOpen then return end
	State.IsOpen = true
	MainFrame.Visible = true
	MainFrame.Size = UDim2.fromOffset(0, 0)
	MainFrame.BackgroundTransparency = 1

	Util.Tween(MainFrame, Util.BackOut(0.55), {
		Size = UDim2.fromOffset(PANEL_W, PANEL_H),
		BackgroundTransparency = 0.06,
	})
	Util.Tween(OrbGlowInner, Util.QuartOut(0.3), { ImageTransparency = 0.2 })
	Util.Tween(OrbGlowOuter, Util.QuartOut(0.3), { ImageTransparency = 0.4 })

	task.delay(0.25, function()
		SetActiveTab("Combat")
	end)
end

local function ClosePanel()
	if not State.IsOpen then return end
	State.IsOpen = false

	local tw = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
	})
	tw:Play()
	tw.Completed:Connect(function()
		MainFrame.Visible = false
		State.IsMinimized = false
	end)
	Util.Tween(OrbGlowInner, Util.QuartOut(0.3), { ImageTransparency = 0.55 })
	Util.Tween(OrbGlowOuter, Util.QuartOut(0.3), { ImageTransparency = 0.78 })
end

local function ToggleMin()
	State.IsMinimized = not State.IsMinimized
	local targetH = State.IsMinimized and 68 or PANEL_H
	Util.Tween(MainFrame, Util.QuartOut(0.4), { Size = UDim2.fromOffset(PANEL_W, targetH) })
end

OpenButton.MouseButton1Click:Connect(function()
	if State.IsOpen then ClosePanel() else OpenPanel() end
end)
CloseButton.MouseButton1Click:Connect(ClosePanel)
MinButton.MouseButton1Click:Connect(ToggleMin)

