    for _, child in ipairs(PlayerListContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, 0, 0, 40)
            pBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
            pBtn.AutoButtonColor = false
            pBtn.Text = "     👤  " .. plr.Name .. "  (@ " .. plr.DisplayName .. " )"
            pBtn.TextColor3 = Color3.fromRGB(210, 210, 220)
            pBtn.Font = Enum.Font.GothamMedium
            pBtn.TextSize = 13
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Parent = PlayerListContainer
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 8)
            
            pBtn.MouseEnter:Connect(function()
                if States.SelectedTarget ~= plr then
                    TweenService:Create(pBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(34, 34, 46)}):Play()
                end
            end)
            pBtn.MouseLeave:Connect(function()
                if States.SelectedTarget ~= plr then
                    TweenService:Create(pBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(24, 24, 32)}):Play()
                end
            end)
            
            pBtn.MouseButton1Click:Connect(function()
                States.SelectedTarget = plr
                for _, btn in ipairs(PlayerListContainer:GetChildren()) do
                    if btn:IsA("TextButton") then
                        TweenService:Create(btn, TweenInfo.new(0.2), {
                            BackgroundColor3 = Color3.fromRGB(24, 24, 32),
                            TextColor3 = Color3.fromRGB(210, 210, 220)
                        }):Play()
                    end
                end
                TweenService:Create(pBtn, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    BackgroundColor3 = CurrentTheme,
                    TextColor3 = Color3.fromRGB(20, 20, 25)
                }):Play()
            end)
        end
    end
end

RefreshPlayerList()
Players.PlayerAdded:Connect(RefreshPlayerList)
Players.PlayerRemoving:Connect(RefreshPlayerList)

