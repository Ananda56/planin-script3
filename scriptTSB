	Btn.TextColor3 = Color3.fromRGB(165, 165, 175)
	Btn.Font = Enum.Font.GothamBold
	Btn.TextSize = 13
	Btn.TextXAlignment = Enum.TextXAlignment.Left
	Btn.AutoButtonColor = false
	Btn.Parent = Sidebar
	Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 12)

	local Indicator = Instance.new("Frame")
	Indicator.Size = UDim2.fromOffset(4, 22)
	Indicator.Position = UDim2.new(0, 0, 0.5, -11)
	Indicator.BackgroundColor3 = CurrentTheme
	Indicator.Visible = false
	Indicator.Parent = Btn
	Instance.new("UICorner", Indicator).CornerRadius = UDim.new(1, 0)
	RegisterTheme(Indicator, "BackgroundColor3")
	ActiveIndicators[name] = Indicator
