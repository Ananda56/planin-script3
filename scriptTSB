local THEMES = {
	{ name = "Gold",    color = Color3.fromHex("#F0C14B") },
	{ name = "Purple",  color = Color3.fromHex("#A78BFA") },
	{ name = "Blue",    color = Color3.fromHex("#60A5FA") },
	{ name = "Green",   color = Color3.fromHex("#34D399") },
	{ name = "Crimson", color = Color3.fromHex("#F87171") },
	{ name = "Pink",    color = Color3.fromHex("#F472B6") },
	{ name = "Cyan",    color = Color3.fromHex("#22D3EE") },
	{ name = "White",   color = Color3.fromHex("#E2E8F0") },
}

local CurrentTheme     = THEMES[1].color
local CurrentThemeName = THEMES[1].name
local ThemeElements    = {}

local function RegisterTheme(obj, prop)
	table.insert(ThemeElements, { Object = obj, Prop = prop })
end

local function ApplyTheme(color, duration)
	duration = duration or 0.4
	CurrentTheme = color
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	for i, item in ipairs(ThemeElements) do
		task.delay((i / #ThemeElements) * 0.08, function()
			pcall(function()
				TweenService:Create(item.Object, info, { [item.Prop] = color }):Play()
			end)
		end)
	end
end

