-- ═══════════════════════════════════════════════════════════════════
local Util = {}

function Util.Tween(obj, t, props)
	if not obj then return end
	local tw = TweenService:Create(obj, t, props)
	tw:Play()
	return tw
end

function Util.QuartOut(dur)
	return TweenInfo.new(dur or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
end

function Util.BackOut(dur)
	return TweenInfo.new(dur or 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

function Util.ElasticOut(dur)
	return TweenInfo.new(dur or 0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
end

function Util.BounceOut(dur)
	return TweenInfo.new(dur or 0.5, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out)
end

function Util.QuintOut(dur)
	return TweenInfo.new(dur or 0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
end

function Util.MakeCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 14)
	c.Parent = parent
	return c
end

function Util.MakeStroke(parent, thickness, color, transparency)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 1
	s.Color = color or Color3.fromRGB(255, 255, 255)
	s.Transparency = transparency or 0.85
	s.Parent = parent
	return s
end

function Util.MakeGlow(parent, size, color, transparency)
	local glow = Instance.new("ImageLabel")
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.5)
	glow.Size = UDim2.new(1, size or 30, 1, size or 30)
	glow.BackgroundTransparency = 1
	glow.Image = "rbxassetid://5028857084"
	glow.ImageColor3 = color or CurrentTheme
	glow.ImageTransparency = transparency or 0.5
	glow.ZIndex = parent.ZIndex - 1
	glow.Parent = parent
	RegisterTheme(glow, "ImageColor3")
	return glow
end

function Util.SafeGet(obj, prop)
	local ok, result = pcall(function() return obj[prop] end)
	if ok then return result end
	return nil
end

function Util.EscapeSearch(query)
	return query:gsub("([%(%)%.%%%+%-%*%?%[%^%$%]])", "%%%1")
end

function Util.FormatCoords(cf)
	if not cf then return "—" end
	local p = cf.Position
	return string.format("X: %.1f  Y: %.1f  Z: %.1f", p.X, p.Y, p.Z)
end

function Util.ClampColor3(c)
	return Color3.new(
		math.clamp(c.R, 0, 1),
		math.clamp(c.G, 0, 1),
		math.clamp(c.B, 0, 1)
	)
end

function Util.Debounce(tbl, key, time)
	time = time or DEBOUNCE
	if tbl[key] then
		local last = tbl[key]
		if tick() - last < time then
			return true
		end
	end
	tbl[key] = tick()
	return false
end

