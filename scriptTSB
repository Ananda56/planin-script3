-- TELEPORT TO TARGET
-- ═══════════════════════════════════════════════════════════════════
local function TeleportToTarget()
	if not State.SelectedTarget then
		Notify("Teleport", "No target selected. Click a player in Radar tab.", 3, "⚡")
		return
	end
	local char = State.SelectedTarget.Character
	if not char then
		Notify("Teleport", "Target has no character.", 2.5, "⚠️")
		return
	end
	local myChar = LocalPlayer.Character
	if not myChar then return end

	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	local tgtRoot = char:FindFirstChild("HumanoidRootPart")
	if myRoot and tgtRoot then
		myRoot.CFrame = tgtRoot.CFrame * CFrame.new(0, 0, 3)
		Notify("Teleported", "Jumped to " .. State.SelectedTarget.Name, 2.5, "⚡")
	end
end

