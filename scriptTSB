local guiParented = false
local guiAttempts = 0
while not guiParented and guiAttempts < 3 do
	guiAttempts = guiAttempts + 1
	local ok = pcall(function() ScreenGui.Parent = CoreGui end)
	if ok and ScreenGui.Parent then
		guiParented = true
	else
		pcall(function() ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui", 5) end)
		if ScreenGui.Parent then guiParented = true end
	end
	if not guiParented and guiAttempts < 3 then
		task.wait(1)
	end
end

