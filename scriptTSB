-- ───────────────────── Open / Close Logic ─────────────────────
local isOpen = false
local isMin  = false

local function OpenPanel()
	if isOpen then return end
	isOpen = true
	MainFrame.Visible = true
	MainFrame.Size = UDim2.fromOffset(0, 0)
	MainFrame.BackgroundTransparency = 1

	TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(720, 480),
		BackgroundTransparency = 0.08
	}):Play()
end

local function ClosePanel()
	if not isOpen then return end
	isOpen = false

	local tw = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1
	})
	tw:Play()
	tw.Completed:Connect(function()
		MainFrame.Visible = false
		isMin = false
	end)
end

OpenButton.MouseButton1Click:Connect(function()
	if isOpen then ClosePanel() else OpenPanel() end
end)

CloseBtn.MouseButton1Click:Connect(ClosePanel)

MinBtn.MouseButton1Click:Connect(function()
	isMin = not isMin
	local size = isMin and UDim2.fromOffset(720, 58) or UDim2.fromOffset(720, 480)
	TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart), {
		Size = size
	}):Play()
end)

