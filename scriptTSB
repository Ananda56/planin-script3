-- ═══════════════════════════════════════════════════════
local spawnCoordLabel = nil

local function FormatCoords(cf)
	if not cf then return "ไม่ได้ตั้งค่า" end
	local p = cf.Position
	return string.format("X:%.1f  Y:%.1f  Z:%.1f", p.X, p.Y, p.Z)
end

local function SetSpawn()
	local char = LocalPlayer.Character
	if not char then
		Notify("Set Spawn", "ไม่พบตัวละคร กรุณาลองใหม่", 2.5, "⚠️")
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		Notify("Set Spawn", "ไม่พบ HumanoidRootPart", 2.5, "⚠️")
		return
	end
	State.SpawnCFrame = root.CFrame
	if spawnCoordLabel then
		spawnCoordLabel.Text = "📍 " .. FormatCoords(State.SpawnCFrame)
	end
	Notify("Set Spawn", "บันทึกจุด Spawn แล้ว:\n" .. FormatCoords(State.SpawnCFrame), 3, "📍")
end

local function GoToSpawn()
	if not State.SpawnCFrame then
		Notify("Go to Spawn", "ยังไม่ได้ตั้งจุด Spawn กด Set ก่อน", 3, "⚠️")
		return
	end
	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = State.SpawnCFrame
		Notify("Go to Spawn", "เทเลพอร์ตไปยังจุด Spawn", 2, "🏃")
	end
end

local function ClearSpawn()
	if not State.SpawnCFrame then
