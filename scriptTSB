-- States & Logic Variables
local States = {
    AutoDie = false,
    SelectedTarget = nil
}

local healthConnection = nil
local isProcessingDeath = false

local function SetupAutoDie()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    if healthConnection then
        healthConnection:Disconnect()
        healthConnection = nil
    end
    
    local lastHealth = humanoid.Health
    
    healthConnection = humanoid.HealthChanged:Connect(function(currentHealth)
        if States.AutoDie and not isProcessingDeath then
            if currentHealth < lastHealth and currentHealth > 0 then
                isProcessingDeath = true
                
                task.wait(0.5)
                
                pcall(function()
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                        LocalPlayer.Character.Humanoid.Health = 0
                    end
                end)
                
                task.wait(1)
                isProcessingDeath = false
            end
        end
        lastHealth = humanoid.Health
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    SetupAutoDie()
end)
if LocalPlayer.Character then
    SetupAutoDie()
end

-- ฟังก์ชันวาร์ปไปหาคนที่เลือก
local function TeleportToTarget()
    if not States.SelectedTarget or not States.SelectedTarget.Character then return end
    
    local myChar = LocalPlayer.Character
    local targetChar = States.SelectedTarget.Character
    
    if not myChar or not targetChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    
    if myRoot and targetRoot then
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
    end
end

