-- AUTO DIE (Fixed: deadlock + cooldown)
-- ═══════════════════════════════════════════════════════════════════
local autoDieConnection = nil
local deathProcessing   = false

local function SetupAutoDie(char)
	if not char then
		char = LocalPlayer.Character
	end
	if not char then return end
	local humanoid = char:FindFirstChild("Humanoid")
	if not humanoid then
		local ok
		ok, humanoid = pcall(function() return char:WaitForChild("Humanoid", 5) end)
		if not ok or not humanoid then return end
	end

	if autoDieConnection then
		autoDieConnection:Disconnect()
		autoDieConnection = nil
	end

	local lastHP = humanoid.Health

	autoDieConnection = humanoid.HealthChanged:Connect(function(newHP)
		if not State.AutoDie then return end
		if deathProcessing then return end
		if newHP <= 0 then
			lastHP = newHP
			return
		end
		if newHP >= lastHP then
			lastHP = newHP
			return
		end

		local now = tick()
		if now - State.AutoDieCooldown < 1.5 then return end

		deathProcessing = true
		State.AutoDieCooldown = now

		Notify("Auto Die", "Damage detected! Resetting in 0.5s...", 1.5, "💀")
		task.wait(0.5)

		local c = LocalPlayer.Character
		if c and c:FindFirstChild("Humanoid") then
			c.Humanoid.Health = 0
		end
		task.wait(1)
		deathProcessing = false
	end)
end

