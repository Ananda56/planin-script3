local function SetActiveTab(name)
	State.ActiveTab = name
	for n, page in pairs(Pages) do
		page.Visible = (n == name)
	end
	for n, data in pairs(NavButtons) do
		local active = (n == name)
		Util.Tween(data.btn, Util.QuartOut(0.3), {
			BackgroundColor3 = active and CurrentTheme or Color3.fromRGB(20, 20, 30),
			BackgroundTransparency = active and 0.1 or 0.65,
			TextColor3 = active and Color3.fromRGB(15, 15, 20) or Color3.fromRGB(130, 130, 150),
		})
		Util.Tween(data.lbl, Util.QuartOut(0.3), {
			TextColor3 = active and CurrentTheme or Color3.fromRGB(100, 100, 120),
		})
		if active then
			local yPos = data.btn.AbsolutePosition.Y - Sidebar.AbsolutePosition.Y + 20
			Util.Tween(TabIndicator, Util.QuartOut(0.4), {
				Position = UDim2.new(0, 0, 0, yPos),
