-- PARTICLE BACKGROUND CANVAS
-- ═══════════════════════════════════════════════════════
local ParticleCanvas = Instance.new("Frame")
ParticleCanvas.Size = UDim2.fromScale(1, 1)
ParticleCanvas.BackgroundTransparency = 1
ParticleCanvas.ClipsDescendants = true
ParticleCanvas.ZIndex = 1
ParticleCanvas.Parent = MainFrame

local particleData = {}
local PARTICLE_COUNT = 18

local function SpawnParticle()
	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(math.random(2, 5), math.random(2, 5))
	dot.Position = UDim2.fromScale(math.random(), math.random())
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.BackgroundColor3 = CurrentTheme
	dot.BackgroundTransparency = math.random(60, 88) / 100
	dot.BorderSizePixel = 0
	dot.ZIndex = 1
	dot.Parent = ParticleCanvas
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
	RegisterTheme(dot, "BackgroundColor3")

	local speed = math.random(12, 30)
	local dirX  = (math.random() - 0.5) * 0.003
	local dirY  = -math.random() * 0.0015 - 0.0005

	table.insert(particleData, { dot = dot, dx = dirX, dy = dirY, life = 0, max = speed })
	return dot
end

for _ = 1, PARTICLE_COUNT do
	SpawnParticle()
end

RunService.Heartbeat:Connect(function(dt)
	for i = #particleData, 1, -1 do
		local p = particleData[i]
		p.life = p.life + dt
		if p.life > p.max then
			p.dot:Destroy()
			table.remove(particleData, i)
			SpawnParticle()
		else
			local t = p.life / p.max
			p.dot.Position = UDim2.new(
				p.dot.Position.X.Scale + p.dx,
				0,
				p.dot.Position.Y.Scale + p.dy,
				0
			)
			p.dot.BackgroundTransparency = 0.6 + t * 0.35
		end
	end
end)

