-- States & Logic Variables
local States = {
    AutoDie = false,
    TargetPlayer = "",
    LaunchPower = 85000 -- เพิ่มความแรงสุดขีดเพื่อให้เป้าหมายตัวปลิวหายไปจากแมพทันทีที่ชน
}

local healthConnection = nil
local isProcessingDeath = false

local function SetupAutoDie()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    if healthConnection then
        healthConnection:Disconnect()
        healthConnection = nil
    end
    
    local lastHealth = humanoid.Health
    
    healthConnection = humanoid.HealthChanged:Connect(function(currentHealth)
        if States.AutoDie and not isProcessingDeath then
            if currentHealth < lastHealth and currentHealth > 0 then
                isProcessingDeath = true
                
                task.wait(0.5)
                
                pcall(function()
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                        LocalPlayer.Character.Humanoid.Health = 0
                    end
                end)
                
                task.wait(1)
                isProcessingDeath = false
            end
        end
        lastHealth = humanoid.Health
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    SetupAutoDie()
end)
if LocalPlayer.Character then
    SetupAutoDie()
end

-- ฟังก์ชันวาร์ปไปกระแทกเป้าหมายแบบรุนแรงเพื่อให้ตัวปลิวทะลุมิติ/นอกโลก
local function LaunchTarget()
    if not States.TargetPlayer or States.TargetPlayer == "" then return end
    
    local targetPlr = nil
    local searchName = string.lower(States.TargetPlayer)
    
    -- ระบบค้นหาชื่อแบบรองรับทั้งพิมพ์ตัวเล็ก-ใหญ่ หรือพิมพ์แค่บางส่วนของชื่อ
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.lower(p.Name) == searchName or string.lower(p.DisplayName) == searchName or string.sub(string.lower(p.Name), 1, #searchName) == searchName then
                targetPlr = p
                break
            end
        end
    end
    
    if not targetPlr or not targetPlr.Character then return end
    
    local myChar = LocalPlayer.Character
    local targetChar = targetPlr.Character
    
    if not myChar or not targetChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
    
    if myRoot and targetRoot then
        -- 1. ยกเลิกสถานะนั่ง/แกล้งตายของเป้าหมายชั่วคราว
        if targetHumanoid then
            targetHumanoid.PlatformStand = false
        end
        
        -- 2. วาร์ปตัวเราไปทับตำแหน่งเป้าหมายพอดีเป๊ะเพื่อสร้างแรงปะทะ (Collision)
        myRoot.CFrame = targetRoot.CFrame
        
        -- 3. เสกแรงกระแทกมหาศาล (LinearVelocity / BodyVelocity + AngularVelocity เพื่อให้หมุนเคว้งคว้างตัวปลิว)
        local attachment = Instance.new("Attachment", targetRoot)
        
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        -- ดีดเป้าหมายพุ่งขึ้นฟ้าและพุ่งออกด้านหน้าอย่างรุนแรง
        bv.Velocity = (targetRoot.CFrame.LookVector * States.LaunchPower) + Vector3.new(0, States.LaunchPower * 1.5, 0)
        bv.Parent = targetRoot
        
        local bav = Instance.new("BodyAngularVelocity")
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.AngularVelocity = Vector3.new(math.random(50, 200), math.random(50, 200), math.random(50, 200))
        bav.Parent = targetRoot
        
        -- ทำลายแรงเหวี่ยงหลังจากผ่านไป 0.6 วินาที (เพื่อให้เป้าหมายปลิวหายลับไป)
        task.delay(0.6, function()
            if bv then bv:Destroy() end
            if bav then bav:Destroy() end
            if attachment then attachment:Destroy() end
        end)
    end
end

