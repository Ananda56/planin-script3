-- SPAWN SYSTEM (Fixed: deadlock, better validation)
-- ═══════════════════════════════════════════════════════════════════
local spawnCoordDisplay = nil

local function SetSpawn()
	local char = LocalPlayer.Character
	if not char then
		Notify("Set Spawn", "Character not found. Try again.", 2.5, "⚠️")
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		Notify("Set Spawn", "HumanoidRootPart not found.", 2.5, "⚠️")
		return
	end
	State.SpawnCFrame = root.CFrame
	if spawnCoordDisplay then
		spawnCoordDisplay.Text = "📍 " .. Util.FormatCoords(State.SpawnCFrame)
	end
	Notify("Set Spawn", "Spawn point saved:\n" .. Util.FormatCoords(State.SpawnCFrame), 3, "📍")
end

local function GoToSpawn()
	if not State.SpawnCFrame then
		Notify("Go to Spawn", "No spawn point set. Press SET first.", 3, "⚠️")
		return
	end
	local char = LocalPlayer.Character
	if not char then
		Notify("Go to Spawn", "Character not loaded.", 2, "⚠️")
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		Notify("Go to Spawn", "HumanoidRootPart not found.", 2, "⚠️")
		return
	end
	local ok, err = pcall(function()
		root.CFrame = State.SpawnCFrame
	end)
	if ok then
		Notify("Go to Spawn", "Teleported to spawn point.", 2, "🏃")
	else
		Notify("Go to Spawn", "Teleport failed: " .. tostring(err), 3, "⚠️")
	end
end

local function ClearSpawn()
	if not State.SpawnCFrame then
		Notify("Clear Spawn", "No spawn point set.", 2, "ℹ️")
		return
	end
	State.SpawnCFrame = nil
	if spawnCoordDisplay then
		spawnCoordDisplay.Text = "📍 Not set"
	end
	Notify("Clear Spawn", "Spawn point cleared.", 2, "🗑️")
end

-- CharacterAdded: AutoDie + AutoSpawn (no deadlock)
LocalPlayer.CharacterAdded:Connect(function(newChar)
	task.wait(0.8)
	SetupAutoDie(newChar)
	if State.AutoSpawn and State.SpawnCFrame then
		task.wait(0.5)
		local root = newChar:FindFirstChild("HumanoidRootPart")
		if root then
			local ok = pcall(function()
				root.CFrame = State.SpawnCFrame
			end)
			if ok then
				Notify("Auto Spawn", "Teleported back to spawn point.", 2.5, "📍")
			end
		end
	end
end)

if LocalPlayer.Character then
	SetupAutoDie(LocalPlayer.Character)
end

