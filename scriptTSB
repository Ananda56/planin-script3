-- PARTICLE BACKGROUND CANVAS (Enhanced)
-- ═══════════════════════════════════════════════════════
local ParticleCanvas = Instance.new("Frame")
ParticleCanvas.Size = UDim2.fromScale(1, 1)
ParticleCanvas.BackgroundTransparency = 1
ParticleCanvas.ClipsDescendants = true
ParticleCanvas.ZIndex = 1
ParticleCanvas.Parent = MainFrame

local particleData = {}
local PARTICLE_COUNT = 28

local function SpawnParticle()
	local size = math.random(2, 6)
	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(size, size)
	dot.Position = UDim2.fromScale(math.random(), math.random())
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.BackgroundColor3 = CurrentTheme
	dot.BackgroundTransparency = math.random(50, 85) / 100
	dot.BorderSizePixel = 0
	dot.ZIndex = 1
	dot.Parent = ParticleCanvas
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
	RegisterTheme(dot, "BackgroundColor3")

	local speed = math.random(15, 35)
	local dirX  = (math.random() - 0.5) * 0.004
	local dirY  = -math.random() * 0.002 - 0.0005
	local wobble = (math.random() - 0.5) * 0.002
	local wobbleSpeed = math.random(1, 3)

	table.insert(particleData, {
		dot = dot,
		dx = dirX,
		dy = dirY,
		wobble = wobble,
		wobbleSpeed = wobbleSpeed,
		life = 0,
		max = speed,
		initialX = math.random(),
	})
	return dot
end

for _ = 1, PARTICLE_COUNT do
	SpawnParticle()
end

-- Particle connection lines
local connectionLines = {}
local function UpdateParticleConnections()
	for i = #connectionLines, 1, -1 do
		local line = connectionLines[i]
		if line then
			pcall(function() line:Destroy() end)
		end
	end
	connectionLines = {}
end

RunService.Heartbeat:Connect(function(dt)
	-- Update particles
	for i = #particleData, 1, -1 do
		local p = particleData[i]
		p.life = p.life + dt
		if p.life > p.max then
			p.dot:Destroy()
			table.remove(particleData, i)
			SpawnParticle()
		else
			local t = p.life / p.max
			local wobbleOffset = math.sin(t * math.pi * 2 * p.wobbleSpeed) * p.wobble
			p.dot.Position = UDim2.new(
				p.dot.Position.X.Scale + p.dx + wobbleOffset * 0.001,
				0,
				p.dot.Position.Y.Scale + p.dy,
				0
			)
			p.dot.BackgroundTransparency = 0.5 + t * 0.45
		end
	end
end)

